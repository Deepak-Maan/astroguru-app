{
  "expo": {
    "name": "AstroGuru",
    "slug": "astroguru-app",
    "owner": "deepak00007jaat",
    "version": "2.8.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "astroguru",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060A12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.astroguru.app"
    },
    "android": {
      "package": "com.astroguru.app",
      "versionCode": 287,
      "adaptiveIcon": {
        "backgroundColor": "#060A12",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "upi"
            },
            {
              "scheme": "gpay"
            },
            {
              "scheme": "phonepe"
            },
            {
              "scheme": "paytmmp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F59E0B"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "386daf97-142e-469d-9319-2b51b7793463"
      }
    }
  }
}
